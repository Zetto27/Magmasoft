<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Registro - MagmaSoft</title>

    <link rel="stylesheet" href="resources/css/registro.css" />

    <!-- ICONOS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- FUENTE -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="container">
      <div class="register-card">
        <img src="resources/css/img/logo.png" class="logo" />

        <h2>Crear usuario</h2>

        <form action="/register" method="POST">
          <div class="input-group">
            <i class="fa fa-user"></i>
            <input type="text" placeholder="Nombre" name="user" required />
          </div>

          <div class="select-container">
            <i class="fas fa-key icon"></i>
            <select name="rol" id="rol" required>
              <option disabled selected>Selecciona una opción</option>
              <option>Administrador</option>
              <option>Supervisor</option>
              <option>Operario</option>
            </select>
          </div>

          <div class="input-group">
            <i class="fa fa-id-card"></i>
            <input type="number" placeholder="Cédula" name="document" required />
          </div>

          <div class="input-group">
            <i class="fa fa-envelope"></i>
            <input type="email" placeholder="Correo electrónico" name="email" required />
          </div>

          <div class="input-group">
            <i class="fa fa-phone"></i>
            <input type="tel" placeholder="Número de teléfono" name="celular" required />
          </div>
          <div class="input-group">
            <i class="fa fa-user"></i>
            <input type="password" placeholder="Contraseña" name="pass" required />
          </div>

          <div class="buttons-container">
          <button type="submit" class="register-btn">
            Guardar
          </button>

          <a href="/users" class="cancel-btn">
            Cancelar
          </a>
        </div>
        </form>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<% if (typeof alert !== "undefined") { %>
<script>
  Swal.fire({
    title: '<%= alertTitle %>',
    text: '<%= alertMessage %>',
    icon: '<%= alertIcon %>',
    showConfirmButton: <%= showConfirmButton %>,
    timer: <%= timer %>
  }).then(() => {
    window.location.href = '<%= ruta %>';
  });
</script>
<% } %>
  </body>
</html>
