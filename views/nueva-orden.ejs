<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Nueva Orden de Trabajo</title>
  <link rel="stylesheet" href="/resources/css/index.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>

<div class="dashboard-layout">
  <%- include('partials/sidebar') %>

  <main class="dashboard-content">
    <%- include('partials/topbar') %>

    <section class="dashboard-header">
      <h2>Nueva Orden de Trabajo</h2>
      <p>Registra una nueva orden en el sistema</p>
    </section>

    <form action="/trabajos/nuevo" method="POST" class="orden-form">

      <div class="form-grid">

        <div class="form-group">
          <label>Óptica *</label>
          <select name="optica_id" required>
            <option value="">Seleccione una óptica</option>
            <% opticas.forEach(optica => { %>
              <option value="<%= optica.id %>"><%= optica.nombre %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Cliente *</label>
          <input type="text" name="cliente_nombre" required />
        </div>

        <div class="form-group">
          <label>Teléfono</label>
          <input type="text" name="cliente_telefono" />
        </div>

        <div class="form-group">
          <label>Tipo de lente *</label>
          <select name="tipo_lente" required>
            <option>Monofocal</option>
            <option>Progresivo</option>
            <option>Bifocal</option>
          </select>
        </div>

        <div class="form-group">
          <label>Tratamiento</label>
          <input type="text" name="tratamiento" />
        </div>

        <div class="form-group">
          <label>Color</label>
          <input type="text" name="color" />
        </div>

        <div class="form-group">
          <label>Material</label>
          <input type="text" name="material" />
        </div>

        <div class="form-group">
          <label>Esfera OD</label>
          <input type="number" step="0.01" name="esfera_od" />
        </div>

        <div class="form-group">
          <label>Esfera OI</label>
          <input type="number" step="0.01" name="esfera_oi" />
        </div>

        <div class="form-group">
          <label>Cilindro OD</label>
          <input type="number" step="0.01" name="cilindro_od" />
        </div>

        <div class="form-group">
          <label>Cilindro OI</label>
          <input type="number" step="0.01" name="cilindro_oi" />
        </div>

        <div class="form-group">
          <label>Eje OD</label>
          <input type="number" name="eje_od" />
        </div>

        <div class="form-group">
          <label>Eje OI</label>
          <input type="number" name="eje_oi" />
        </div>

        <div class="form-group">
          <label>Adición</label>
          <input type="number" step="0.01" name="adicion_val" />
        </div>

        <div class="form-group">
          <label>DP</label>
          <input type="text" name="dp" />
        </div>

      </div>

      <div class="form-group full">
        <label>Observaciones</label>
        <textarea name="observaciones" rows="4"></textarea>
      </div>

      <div class="form-actions">
        <a href="/trabajos" class="btn-secondary">Cancelar</a>
        <button type="submit" class="btn-primary">
          <i class="fas fa-save"></i> Guardar Orden
        </button>
      </div>

    </form>
  </main>
</div>

</body>
</html>