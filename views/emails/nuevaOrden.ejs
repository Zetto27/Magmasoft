<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>MagmaSoft</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 40px;
      background: #f3f4f6;
      font-family: Arial, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table
            width="650"
            cellpadding="0"
            cellspacing="0"
            style="background: #ffffff; border-radius: 15px; overflow: hidden"
          >
            <tr>
              <td
                style="
                  background: #2563eb;
                  color: white;
                  padding: 35px;
                  text-align: center;
                "
              >
                <h1 style="margin: 0; font-size: 32px">MAGMASOFT</h1>

                <p style="margin-top: 10px">Seguimiento de Órdenes</p>
              </td>
            </tr>

            <tr>
              <td style="padding: 40px">
                <h2 style="margin-top: 0">
                  Hola <%= trabajo.cliente_nombre %>
                </h2>

                <p>Su orden fue registrada correctamente.</p>
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    margin-top: 30px;
                    border-collapse: collapse;
                    border: 1px solid #e5e7eb;
                  "
                >
                  <tr>
                    <td
                      style="
                        background: #f8fafc;
                        padding: 14px;
                        font-weight: bold;
                        width: 220px;
                        border: 1px solid #e5e7eb;
                      "
                    >
                      Código
                    </td>

                    <td style="padding: 14px; border: 1px solid #e5e7eb">
                      <%= trabajo.codigo %>
                    </td>
                  </tr>

                  <tr>
                    <td
                      style="
                        background: #f8fafc;
                        padding: 14px;
                        font-weight: bold;
                        border: 1px solid #e5e7eb;
                      "
                    >
                      Óptica
                    </td>

                    <td style="padding: 14px; border: 1px solid #e5e7eb">
                      <%= trabajo.optica %>
                    </td>
                  </tr>

                  <tr>
                    <td
                      style="
                        background: #f8fafc;
                        padding: 14px;
                        font-weight: bold;
                        border: 1px solid #e5e7eb;
                      "
                    >
                      Estado
                    </td>

                    <td style="padding: 14px; border: 1px solid #e5e7eb">
                      <%= trabajo.estado %>
                    </td>
                  </tr>

                  <tr>
                    <td
                      style="
                        background: #f8fafc;
                        padding: 14px;
                        font-weight: bold;
                        border: 1px solid #e5e7eb;
                      "
                    >
                      Fecha estimada de entrega
                    </td>

                    <td style="padding: 14px; border: 1px solid #e5e7eb">
                      <%= fechaEntrega %>
                    </td>
                  </tr>
                </table>
                <div
                  style="
                    text-align: center;
                    margin-top: 35px;
                    margin-bottom: 35px;
                  "
                >
                  <a
                    href="<%= url %>"
                    style="
                      background: #2563eb;
                      color: #ffffff;
                      text-decoration: none;
                      padding: 16px 34px;
                      border-radius: 10px;
                      font-weight: bold;
                      display: inline-block;
                      font-size: 16px;
                    "
                  >
                    Consultar mi pedido
                  </a>
                </div>
                <div style="text-align: center">
                  <p
                    style="color: #6b7280; font-size: 15px; margin-bottom: 15px"
                  >
                    También puede escanear este código QR
                  </p>
                  <img
                    src="cid:codigoQR"
                    width="200"
                    height="200"
                    alt="Código QR"
                    style="display: block; margin: auto"
                  />
                </div>
                <hr
                  style="
                    margin-top: 40px;
                    border: none;
                    border-top: 1px solid #e5e7eb;
                  "
                />

                <p
                  style="
                    text-align: center;
                    color: #6b7280;
                    font-size: 14px;
                    line-height: 1.8;
                  "
                >
                  Gracias por confiar en
                  <strong>MagmaSoft</strong>
                  <br />
                  Este correo fue generado automáticamente.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
