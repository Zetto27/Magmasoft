<!--
==================================================================
MÓDULO: AUTENTICACIÓN DE USUARIOS

PROYECTO:
MagmaSoft

DESCRIPCIÓN:
Vista encargada de permitir el acceso de los usuarios
al sistema mediante la validación de credenciales.

CASO DE USO RELACIONADO:
CU-01 Iniciar Sesión

HISTORIA DE USUARIO:
Como usuario del sistema,
quiero autenticarme mediante mis credenciales
para acceder a las funcionalidades de MagmaSoft
según los permisos asignados.

ARTEFACTOS RELACIONADOS:
- Diagrama de Casos de Uso
- Diagrama de Clases
- Historias de Usuario
- Prototipos de Interfaz
- Modelo de Datos
- Plan de Trabajo del Proyecto

==================================================================
-->
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>MagmaSoft Login</title>

    <!-- =========================================
        HOJAS DE ESTILO DEL MÓDULO
    ========================================== -->

    <link rel="stylesheet" href="resources/css/login.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="container">
      <!-- =========================================
          PANEL INFORMATIVO
          Presenta información descriptiva
          del sistema MagmaSoft.
      ========================================== -->
      <div class="left-panel">
        <img
          src="resources/css/img/Logo.png"
          alt="MagmaSoft"
          class="brand-logo"
        />

        <h1>
          Bienvenido a
          <br />
          <span>MagmaSoft</span>
        </h1>

        <div class="line"></div>

        <p>
          MagmaSoft centraliza y automatiza
          <br />
          los procesos de laboratorios ópticos.
          <br />
        </p>
      </div>

      <!-- =========================================
        FORMULARIO DE AUTENTICACIÓN 
        Permite validar las credenciales
        de acceso del usuario.
      ========================================== -->
      <div class="login-card">
        <div class="logo"></div>

        <h2>Inicio de sesión</h2>

        <form action="/auth" method="POST">
          <!-- Campo de identificación -->
          <div class="input-group">
            <input
              type="text"
              name="document"
              id="document"
              placeholder="Cédula"
              autocomplete="off"
              required
            />
          </div>
          <!-- Campo de contraseña -->
          <div class="input-group">
            <input
              type="password"
              name="pass"
              id="pass"
              placeholder="Contraseña"
              autocomplete="new-password"
              required
            />
          </div>
          <!-- Botón de autenticación -->
          <button type="submit" class="login-btn">Iniciar sesión</button>
        </form>
      </div>
    </div>
    <!-- =========================================
            LIBRERÍA SWEETALERT
            Permite mostrar mensajes visuales
            de éxito, error o advertencia.
    ========================================== -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- =========================================
            MENSAJES DINÁMICOS DEL SISTEMA
            Muestra alertas enviadas desde el
            servidor luego de procesos de login.
      ========================================== -->
    <% if (typeof alert !== "undefined") { %>
    <script>
      Swal.fire({
        title: '<%= alertTitle %>',
        text: '<%= alertMessage %>',
        icon: '<%= alertIcon %>',
        showConfirmButton: <%= showConfirmButton %>,
        timer: <%= timer %>
      }).then(() => {
        window.location.href = '/<%= ruta %>';
      });
    </script>
    <% } %>
  </body>
</html>
