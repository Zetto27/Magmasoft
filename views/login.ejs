<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>MagmaSoft Login</title>

    <link rel="stylesheet" href="resources/css/login.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="container">

      <!-- PANEL IZQUIERDO -->
      <div class="left-panel">
        <img src="resources/css/img/Logo.png" alt="MagmaSoft" class="brand-logo" />

        <h1>
          Bienvenido a <br />
          <span>MagmaSoft</span>
        </h1>

        <div class="line"></div>

        <p>
          Sistema de gestión inteligente para<br />
          administrar y optimizar procesos<br />
          de tu empresa.
        </p>
      </div>

      <!-- TARJETA LOGIN -->
      <div class="login-card">
        <div class="logo">
        </div>

        <h2>Inicio de sesión</h2>

        <form action="/auth" method="POST">
          <div class="input-group">
            <input
              type="text"
              name="document"
              id="document"
              placeholder="Cédula"
              required
            />
          </div>

          <div class="input-group">
            <input
              type="password"
              name="pass"
              id="pass"
              placeholder="Contraseña"
              required
            />
          </div>

          <div class="options">
            <label>
              <input type="checkbox" />
              Recordar sesión
            </label>
          </div>

          <button type="submit" class="login-btn">
            Iniciar sesión
          </button>

          <div class="links">
            <a href="/registro">Registrarse</a>
          </div>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <% if (typeof alert !== "undefined") { %>
    <script>
      Swal.fire({
        title: '<%= alertTitle %>',
        text: '<%= alertMessage %>',
        icon: '<%= alertIcon %>',
        showConfirmButton: <%= showConfirmButton %>,
        timer: <%= timer %>
      }).then(() => {
        window.location.href = '<%= ruta %>';
      });
    </script>
    <% } %>
  </body>
</html>