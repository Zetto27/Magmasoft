<!--
==================================================================
COMPONENTE: MENÚ LATERAL DE NAVEGACIÓN (SIDEBAR)

PROYECTO:
MagmaSoft

DESCRIPCIÓN:
Componente reutilizable encargado de la navegación
principal del sistema.

FUNCIONALIDADES:
- Acceso al Dashboard.
- Acceso al módulo de Trabajos.
- Acceso al módulo de Usuarios.
- Acceso al módulo de Reportes.
- Cierre de sesión.

CASOS DE USO RELACIONADOS:
- CU-01 Iniciar Sesión.
- CU-02 Gestionar Usuarios.
- CU-03 Gestionar Trabajos.
- CU-04 Consultar Reportes.
- CU-05 Cerrar Sesión.

ARTEFACTOS RELACIONADOS:
- Diagrama de Casos de Uso.
- Prototipo de Navegación.
- Diseño de Interfaz.
- Historias de Usuario.
==================================================================
-->
<aside class="sidebar">
  <!-- ==========================================
    BOTÓN DE COLAPSO DEL MENÚ
    Permite expandir o contraer el panel lateral para optimizar el espacio disponible en pantalla.
  ========================================== -->
  <div class="sidebar-top">
    <button class="toggle-btn" onclick="toggleSidebar()">
      <i class="fas fa-bars"></i>
    </button>
  </div>
  <!-- ==========================================
    MENÚ PRINCIPAL DE NAVEGACIÓN
  ========================================== -->
  <nav class="sidebar-nav">
    <!-- Dashboard -->
    <a href="/" class="nav-link <%= page === 'dashboard' ? 'active' : '' %>">
      <i class="fas fa-chart-pie"></i>
      <span>Dashboard</span>
    </a>

    <a
      href="/trabajos"
      class="nav-link <%= page === 'trabajos' ? 'active' : '' %>"
    >
      <i class="fas fa-briefcase"></i>
      <span>Orden</span>
    </a>

    <a href="/users" class="nav-link <%= page === 'users' ? 'active' : '' %>">
      <i class="fas fa-users"></i>
      <span>Usuarios</span>
    </a>

    <a
      href="/reportes"
      class="nav-link <%= page === 'reportes' ? 'active' : '' %>"
    >
      <i class="fas fa-chart-line"></i>
      <span>Reportes</span>
    </a>

    <!-- <a
      href="/configuracion"
      class="nav-link <%= page === 'configuracion' ? 'active' : '' %>"
    >
      <i class="fas fa-cog"></i>
      <span>Configuración</span>
    </a> -->
  </nav>
  <!-- ==========================================
    CIERRE DE SESIÓN
    Finaliza la sesión activa del usuario y redirige al módulo de autenticación.
  ========================================== -->
  <a href="/logout" class="logout-btn nav-link">
    <i class="fas fa-sign-out-alt"></i>
    <span>Salir</span>
  </a>
</aside>
