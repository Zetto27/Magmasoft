<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Gestión de Trabajos</title>
    

    <link rel="stylesheet" href="/resources/css/index.css" />
    <link rel="stylesheet" href="/resources/css/trabajos.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <script>
      if (localStorage.getItem("sidebarCollapsed") === "true") {
        document.documentElement.classList.add("sidebar-collapsed");
      }
      function generarCodigoTrabajo(id) {

  return (
    "TR-" +
    String(id).padStart(3, "0")
  );

}
    </script>
  </head>

  <body>
    <div class="dashboard-layout">
      <%- include('partials/sidebar') %>

      <main class="dashboard-content">
        <!-- TOPBAR FIJA -->
        <%- include('partials/topbar') %>

        <!-- ÁREA SCROLLEABLE -->
        <div class="dashboard-scroll">
          <!-- HEADER STICKY -->
          <section class="dashboard-header">
            <h2>Gestión de Trabajosss</h2>
            <p>Administra los trabajos registrados en el sistema</p>
          </section>

          <section class="map-card trabajos-container">
            <!-- TOOLBAR -->
            <section class="trabajos-toolbar">
<div class="search-box">
  <i class="fas fa-search"></i>

  <input
    type="text"
    id="buscarTrabajo"
    placeholder="Buscar por código, cliente u óptica..."
  />
</div>

              <button class="btn-filter">
                <i class="fas fa-filter"></i>
                Filtros
              </button>

<button
  class="btn-primary"
  onclick="abrirModalNuevaOrden()"
>
  <i class="fas fa-plus"></i>
  Nueva orden
</button>
            </section>

            <!-- TABLA -->
            <section class="trabajos-card">
              <table class="trabajos-table">
                <thead>
               <tr>
                    <th>Código / QR</th>
                    <th>Cliente / Óptica</th>
                    <th>Tipo de lente</th>
                    <th>Etapa actual</th>
                    <th>Estado</th>
                    <th>Operario</th>
                    <th>Fecha creación</th>
                    <th>Acciones</th>
                  </tr>
                </thead>

<tbody>

  <% if (trabajos.length > 0) { %>

    <tr id="sinTrabajos" style="display:none;">
  <td colspan="8" style="text-align:center;padding:30px;">
    No se encontraron trabajos
  </td>
</tr>
    <% trabajos.forEach(trabajo => { %>

      <tr class="fila-trabajo">

        <td><%= trabajo.codigo %></td>

        <td><%= trabajo.cliente_nombre %></td>

        <td><%= trabajo.tipo_lente %></td>

        <td>

          <% if (trabajo.estado === 'En proceso') { %>

            <span class="badge blue">
              <%= trabajo.estado %>
            </span>

          <% } else if (trabajo.estado === 'Pendiente') { %>

            <span class="badge yellow">
              <%= trabajo.estado %>
            </span>

          <% } else { %>

            <span class="badge">
              <%= trabajo.estado %>
            </span>

          <% } %>

        </td>

        <td><%= trabajo.etapa_actual || 'Sin etapa' %></td>

        <td><%= trabajo.operario_nombre || 'Sin asignar' %></td>

        <td>

         <%= new Date(trabajo.fecha_creacion).toLocaleDateString('es-CO') %>

        </td>

      <td class="actions">

      <a href="/trabajos/<%= trabajo.id %>">

  <i class="fas fa-eye"></i>

</a>

        <i class="fas fa-pen"></i>

        <i
          class="fas fa-trash"
          onclick="eliminarTrabajo(
            '<%= trabajo.id %>',
            '<%= trabajo.codigo %>'
          )"
        ></i>

</td>

      </tr>

    <% }) %>

  <% } else { %>

    <tr>

      <td colspan="8" style="text-align:center;padding:30px;">

        No existen trabajos registrados

      </td>

    </tr>

  <% } %>

</tbody>
              </table>
            </section>

            <!-- DETALLE -->
            <section class="trabajo-detalle-grid">
              <div class="detalle-card">
                <h3>Detalle del trabajo: MAG-000125</h3>

                <div class="timeline">
                  <div class="timeline-step done">
                    <div class="circle">
                      <i class="fas fa-check"></i>
                    </div>
                    <span>Recepción</span>
                  </div>

                  <div class="timeline-step active">
                    <div class="circle">2</div>
                    <span>Tallado</span>
                  </div>

                  <div class="timeline-step">
                    <div class="circle">3</div>
                    <span>Tratamiento</span>
                  </div>

                  <div class="timeline-step">
                    <div class="circle">4</div>
                    <span>Pulido</span>
                  </div>

                  <div class="timeline-step">
                    <div class="circle">5</div>
                    <span>Ensamble</span>
                  </div>

                  <div class="timeline-step">
                    <div class="circle">6</div>
                    <span>Validación</span>
                  </div>

                  <div class="timeline-step">
                    <div class="circle">7</div>
                    <span>Entregado</span>
                  </div>
                </div>

                <div class="detalle-info">
                  <div>
                    <p>
                      <strong>Cliente / Óptica:</strong>
                      Óptica Visión Total
                    </p>
                    <p>
                      <strong>Tipo de lente:</strong>
                      Monofocal
                    </p>
                    <p>
                      <strong>Observaciones:</strong>
                      Ninguna
                    </p>
                  </div>

                  <div>
                    <p>
                      <strong>Operario actual:</strong>
                      Juan Pérez
                    </p>
                    <p>
                      <strong>Fecha estimada entrega:</strong>
                      27/05/2025
                    </p>
                    <p>
                      <strong>Tiempo en etapa actual:</strong>
                      1h 15m
                    </p>
                  </div>
                </div>

                <button class="btn-primary update-btn">Actualizar etapa</button>
              </div>

              <!-- PANEL DERECHO -->
              <div class="side-panel">
                <div class="comments-card">
                  <h4>Historial de comentarios</h4>

                  <div class="comment-item">
                    <strong>Juan Pérez</strong>
                    <span>24/05 10:30</span>
                    <p>Inicia tallado del lente.</p>
                  </div>

                  <div class="comment-item">
                    <strong>Claudia Mogollon</strong>
                    <span>24/05 09:30</span>
                    <p>Trabajo recibido correctamente.</p>
                  </div>
                </div>

                <div class="info-card">
                  <h4>Información adicional</h4>
                  <p>
                    <strong>Código / QR:</strong>
                    MAG-000125
                  </p>
                  <p>
                    <strong>Teléfono cliente:</strong>
                    310 123 4567
                  </p>
                  <p>
                    <strong>Fecha creación:</strong>
                    24/05/2025
                  </p>
                  <p>
                    <strong>Material:</strong>
                    CR-39
                  </p>
                  <p>
                    <strong>Color:</strong>
                    Transparente
                  </p>
                </div>
              </div>
            </section>
          </section>
        </div>
      </main>
    </div>

    <script>
      const layout = document.querySelector(".dashboard-layout");

      if (document.documentElement.classList.contains("sidebar-collapsed")) {
        layout.classList.add("collapsed");
      }

      function toggleSidebar() {
        layout.classList.toggle("collapsed");

        const collapsed = layout.classList.contains("collapsed");

        localStorage.setItem("sidebarCollapsed", collapsed);

        document.documentElement.classList.toggle("sidebar-collapsed", collapsed);
      }

      document.querySelectorAll(".nav-link").forEach((link) => {
        if (link.href === window.location.href) {
          link.classList.add("active");
        }
      });
    </script>
    <script>

const buscadorTrabajo =
  document.getElementById("buscarTrabajo");

buscadorTrabajo.addEventListener("keyup", function () {

  const texto =
    this.value.toLowerCase();

  const filas =
   document.querySelectorAll("tbody .fila-trabajo");

  let encontrados = 0;

  filas.forEach((fila) => {

    const contenido =
      fila.textContent.toLowerCase();

    if (contenido.includes(texto)) {

      fila.style.display = "";
      encontrados++;

    } else {

      fila.style.display = "none";

    }

  });

  const mensaje =
    document.getElementById("sinTrabajos");

  if (encontrados === 0) {

    mensaje.style.display = "";

  } else {

    mensaje.style.display = "none";

  }

});

</script>
<script>

function eliminarTrabajo(id, codigo) {

  Swal.fire({

    title: '¿Eliminar trabajo?',

    text:
      'Se eliminará la orden ' + codigo,

    icon: 'warning',

    showCancelButton: true,

    confirmButtonColor: '#2563eb',

    cancelButtonColor: '#d33',

    confirmButtonText: 'Sí, eliminar',

    cancelButtonText: 'Cancelar'

  }).then((result) => {

    if (result.isConfirmed) {

      window.location.href =
        '/trabajos/delete/' + id;

    }

  });

}

</script>
<script>

function abrirModalNuevaOrden() {

  document.getElementById(
    "modalNuevaOrden"
  ).style.display = "flex";

}

function cerrarModalNuevaOrden() {

  document.getElementById(
    "modalNuevaOrden"
  ).style.display = "none";

}

</script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- MODAL NUEVA ORDEN -->

<div
  id="modalNuevaOrden"
  class="modal-overlay"
  style="display:none;"
>

  <div class="modal-content modal-grande">

    <div class="modal-header">

      <h2>Nueva Orden</h2>

      <button
        class="close-modal"
        onclick="cerrarModalNuevaOrden()"
      >
        ×
      </button>

    </div>

    <form id="formNuevaOrden">

      <!-- DATOS CLIENTE -->

      <h3>Datos del Cliente</h3>

      <div class="form-grid">

        <input
          type="text"
          placeholder="Nombre del paciente"
        >

        <input
          type="text"
          placeholder="Teléfono"
        >

<select
  name="optica_id"
  required
>

  <option value="">
    Seleccione una óptica
  </option>

  <% opticas.forEach(optica => { %>

    <option value="<%= optica.id %>">

      <%= optica.nombre %>

    </option>

  <% }) %>

</select>

      </div>

      <!-- FORMULA -->

      <h3>Fórmula Oftálmica</h3>

      <div class="form-grid">

        <input
          type="number"
          step="0.25"
          placeholder="Esfera OD"
        >

        <input
          type="number"
          step="0.25"
          placeholder="Cilindro OD"
        >

        <input
          type="number"
          placeholder="Eje OD"
        >

        <input
          type="number"
          step="0.25"
          placeholder="Esfera OI"
        >

        <input
          type="number"
          step="0.25"
          placeholder="Cilindro OI"
        >

        <input
          type="number"
          placeholder="Eje OI"
        >

        <input
          type="number"
          step="0.25"
          placeholder="Adición"
        >

        <input
          type="text"
          placeholder="DP"
        >

      </div>

      <!-- FABRICACION -->

      <h3>Fabricación</h3>

      <div class="form-grid">

        <input
          type="text"
          placeholder="Tipo lente"
        >

        <input
          type="text"
          placeholder="Material"
        >

        <input
          type="text"
          placeholder="Color"
        >

        <input
          type="text"
          placeholder="Tratamiento"
        >

      </div>

      <!-- PRODUCCION -->

      <h3>Producción</h3>
      <div class="form-grid">

        

<select name="operario_actual_id">

  <option value="">
    Seleccione operario
  </option>

  <% operarios.forEach(operario => { %>

    <option value="<%= operario.id %>">
      <%= operario.user %> (<%= operario.rol %>)
    </option>

  <% }) %>

</select>

        <input
          type="date"
        >

      </div>

      <textarea
        rows="4"
        placeholder="Observaciones"
      ></textarea>

      <div class="modal-actions">

        <button
          type="button"
          class="btn-secondary"
          onclick="cerrarModalNuevaOrden()"
        >
          Cancelar
        </button>

        <button
          type="submit"
          class="btn-primary"
        >
          Guardar Orden
        </button>

      </div>

    </form>

  </div>

</div>
  </body>
</html>
